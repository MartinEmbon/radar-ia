# Copiá este archivo como .env para correr el radar en tu Mac (scripts/run_local.sh).
# Nunca subas el .env al repo.

# Claude: usá UNO de los dos
CLAUDE_CODE_OAUTH_TOKEN=      # sale de `claude setup-token` (usa tu suscripción)
ANTHROPIC_API_KEY=            # o una API key de console.anthropic.com

# Audio
TTS_PROVIDER=openai           # openai | elevenlabs | none
OPENAI_API_KEY=
OPENAI_TTS_VOICE=ash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ruta a tu vault de Obsidian (la nota cae en <vault>/Radar/AAAA-MM-DD.md)
OBSIDIAN_VAULT="$HOME/Documents/Obsidian/MiVault"

# Opcional: GitHub token para más límite en la búsqueda de repos
GITHUB_TOKEN=
